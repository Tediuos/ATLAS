# Copy to .env. Keep actual credentials out of Git.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Separate editorial evaluator, called automatically after article generation.
JUDGE_PROVIDER=groq
JUDGE_MODEL=llama-3.3-70b-versatile

# Alternative local backend; selected only when LLM_PROVIDER=ollama.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# WordPress writes pause for review, including drafts.
WP_URL=https://yoursite.com
WP_USER=
WP_APP_PASSWORD=

# LinkedIn Posts API. Drafts stay local until an explicit review approval.
# Access token needs w_member_social (member) or approved organization permissions.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202606

# Private local state. To reuse a previous root database, set ATLAS_DB_PATH=atlas.db.
ATLAS_DB_PATH=data/atlas.db
ATLAS_STATE_DIR=data

# Explicitly enable only for trusted local/private development sites.
ATLAS_ALLOW_PRIVATE_URLS=false

# External tracing is off by default. Checkpoints and metrics are available locally.
LANGSMITH_TRACING=false
