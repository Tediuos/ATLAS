# ======================================================
# Atlas SEO Agent — environment variable reference
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ======================================================

# ── LLM Provider ────────────────────────────────────
# Which LLM backend to use: "groq" (cloud, free tier) or "ollama" (local)
LLM_PROVIDER=groq

# ── Groq (cloud) ─────────────────────────────────────
# Create a free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq model to use — llama-3.3-70b-versatile is free-tier capable
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (local) ────────────────────────────────────
# Only needed when LLM_PROVIDER=ollama.
# Run Ollama locally: https://ollama.com
OLLAMA_MODEL=qwen2.5:7b

# ── WordPress ─────────────────────────────────────────
# Full URL of your WordPress site (no trailing slash)
WP_URL=https://yoursite.com

# WordPress login username
WP_USER=admin

# WordPress Application Password
# Generate at: WordPress Admin → Users → Your Profile → Application Passwords
# Format: xxxx xxxx xxxx xxxx xxxx xxxx  (spaces are fine)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Optional: Atlas database ──────────────────────────
# Path to the SQLite database file (default: atlas.db in project root)
# ATLAS_DB_PATH=./atlas.db
